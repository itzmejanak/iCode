<?xml version="1.0" encoding="utf-8"?>
<!--
  A valid drawable that paints nothing.

  The system splash must show the app's background alone, so the designed
  splash frame is the only mark the user sees. An icon is still required: given
  an empty or absent one, Android substitutes the launcher icon, which is a
  white tile and reads as a second, foreign splash.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:pathData="M0,0 L108,0 L108,108 L0,108 Z"
        android:fillColor="#00000000" />
</vector>
