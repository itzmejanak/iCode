<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- All Files Access: Import reads a folder on phone storage, and only reads it. Asked where
         Import needs it, never at onboarding (docs/workspace-storage-plan.md §4.8). -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <!-- Downloading the runtime root filesystem. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Long-running builds, servers and shells continue while the UI is hidden. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- The notification's wakelock toggle: keeps the CPU running for long
         terminal work with the screen off, only while the user asks. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Onboarding and Terminal Settings show Android's own prompt to exempt
         iCode from battery optimization (owner's decision). Google Play
         allows this only for listed use cases; see
         docs/terminal-background-plan.md §7. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Every workspace lives in iCode's own storage (docs/workspace-storage-plan.md §4.7):
         uninstalling asks whether to keep that data. App info keeps Android's own Clear
         storage (owner, 2026-09-30). -->
    <application
        android:allowBackup="false"
        android:hasFragileUserData="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Icode.Splash">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|density"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The workspaces in Android's Files app, and to any app the user picks them for;
             only the system's documents UI binds it (docs/workspace-storage-plan.md §4.6). -->
        <provider
            android:name="dev.icode.mobile.data.storage.WorkspacesProvider"
            android:authorities="${applicationId}.workspaces"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>

        <service
            android:name="dev.icode.mobile.data.runtime.RuntimeForegroundService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Continues user-started developer processes such as builds, development servers and interactive shells while the app is in the background." />
        </service>
    </application>

</manifest>
