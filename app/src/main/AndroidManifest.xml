<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- All Files Access: Import reads a folder on phone storage, and only reads it. Asked where
         Import needs it, never at onboarding (docs/workspace-storage-plan.md §4.8). -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <!-- Downloading the runtime root filesystem. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Long-running builds, servers and shells continue while the UI is hidden. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Voice (docs/phone-agent-plan.md §5.8): the microphone, only while listening; from the bubble
         through phone control's service, which holds it while iCode is away. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- The notification's wakelock toggle: keeps the CPU running for long
         terminal work with the screen off, only while the user asks. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Onboarding and Terminal Settings show Android's own prompt to exempt
         iCode from battery optimization (owner's decision). Google Play
         allows this only for listed use cases; see
         docs/terminal-background-plan.md §7. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Build & Run installs the app it built, through Android's package installer: Android asks
         the user to allow it once, and confirms each install (docs/android-toolchain-plan.md §4.5).
         Distribution through Google Play requires declaring this use. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Phone control (docs/phone-agent-plan.md): the apps the launcher lists, opened by name;
         Shizuku, found to say its state. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <package android:name="moe.shizuku.privileged.api" />
        <!-- Voice: Android's speech recognition and text-to-speech engines, found from Android 11. -->
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <!-- Every workspace lives in iCode's own storage (docs/workspace-storage-plan.md §4.7):
         uninstalling asks whether to keep that data. App info keeps Android's own Clear
         storage (owner, 2026-09-30). -->
    <application
        android:name=".ICodeApplication"
        android:allowBackup="false"
        android:hasFragileUserData="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Icode.Splash">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|density"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- A remote MCP server's sign-in comes back here, on iCode's own scheme (docs/mcp-plan.md §8.2). -->
        <activity
            android:name=".SignInReturnActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="${applicationId}" />
            </intent-filter>
        </activity>

        <!-- The workspaces in Android's Files app, and to any app the user picks them for;
             only the system's documents UI binds it (docs/workspace-storage-plan.md §4.6). -->
        <provider
            android:name="dev.icode.mobile.data.storage.WorkspacesProvider"
            android:authorities="${applicationId}.workspaces"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>

        <!-- A file handed to another app, one URI and one grant at a time: a workspace's or phone
             storage's file to Open with or Share (docs/open-with-plan.md), and the assistant's photo
             the camera app writes (docs/assistant-koog-plan.md §13 P6). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/shared_file_paths" />
        </provider>

        <!-- The assistant on the whole phone (docs/phone-agent-plan.md §5.1): it reads and operates the
             screen for the user's own requests, and hosts the bubble and the glow. Not an
             accessibility tool, and never claims to be one (§3.2). -->
        <service
            android:name="dev.icode.mobile.data.phone.PhoneService"
            android:exported="false"
            android:label="@string/phone_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/phone_service" />
        </service>

        <!-- Shizuku hands iCode its binder through this provider; only system-level callers reach it
             (Shizuku-API's README, §5.11). -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <!-- Phone control's service (docs/phone-agent-plan.md §5.8, §5.9): keeps the agent alive while
             phone control is on, and the microphone for the bubble while iCode is away. -->
        <service
            android:name="dev.icode.mobile.data.phone.PhoneForegroundService"
            android:exported="false"
            android:foregroundServiceType="specialUse|microphone">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the on-screen assistant the user turned on in Accessibility settings running, and able to hear the user, while they use other apps." />
        </service>

        <service
            android:name="dev.icode.mobile.data.runtime.RuntimeForegroundService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Continues user-started developer processes such as builds, development servers, interactive shells and a coding assistant's work while the app is in the background." />
        </service>
    </application>

</manifest>
