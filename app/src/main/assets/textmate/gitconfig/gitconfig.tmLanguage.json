      "patterns": [
        {
          "include": "#escapedNewline"
        }
      ]
    },
    "L:string.quoted.double.gitconfig source.embedded.shell - string.quoted.*.shell": {
      "patterns": [
        {
          "name": "comment.line.number-sign.shell",
          "begin": "\\s*(?<![^\\s;\\\\|\\(&])(#)",
          "end": "(?=\")",
          "beginCaptures": {
            "1": {
              "name": "punctuation.definition.comment.shell"
            }
          }
        }
      ]
    }
  },
