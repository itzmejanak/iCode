{
  "name": "icode-light-preview",
  "settings": [
    { "settings": { "background": "#ECEFE9", "foreground": "#172018", "caret": "#B4470C", "lineHighlight": "#E7EBE5", "selection": "#F4CBB7" } },
    { "scope": "comment", "settings": { "foreground": "#647467" } },
    { "scope": "keyword,storage,keyword.operator", "settings": { "foreground": "#B4470C" } },
    { "scope": "string", "settings": { "foreground": "#106B4B" } },
    { "scope": "constant.numeric,constant.language", "settings": { "foreground": "#235B9B" } },
    { "scope": "entity.name.type,support.type", "settings": { "foreground": "#7A5100" } },
    { "scope": "entity.name.function,support.function", "settings": { "foreground": "#235B9B" } },
    { "scope": "variable,identifier", "settings": { "foreground": "#172018" } },
    { "scope": "invalid", "settings": { "foreground": "#B42318" } }
  ]
}
