# syntax=docker/dockerfile:1.7
# escape=\
ARG BASE=ubuntu:24.04
FROM --platform=$BUILDPLATFORM golang:1.22-alpine AS build
ARG VERSION=1.0 TARGETOS
ENV APP_HOME=/app PORT="8080" \
    DEBUG=false
ENV LEGACY_KEY legacy value
WORKDIR ${APP_HOME}
COPY --from=build --chown=app:app /src/bin /usr/local/bin/
ADD https://example.com/archive.tar.gz /tmp/
RUN --mount=type=cache,target=/root/.cache apt-get update && \
    apt-get install -y curl git  # tools
RUN <<EOF
echo "hello $PORT"
EOF
EXPOSE 8080/tcp 9090
USER app
VOLUME ["/data"]
STOPSIGNAL SIGTERM
HEALTHCHECK --interval=30s CMD curl -f http://localhost:${PORT:-8080}/ || exit 1
CMD ["./server", "--port", "8080"]
ENTRYPOINT exec ./server
LABEL org.opencontainers.image.source="https://example.com" version=2
ONBUILD RUN make build
FROM scratch@sha256:0123456789abcdef
SHELL ["/bin/bash", "-c"]
