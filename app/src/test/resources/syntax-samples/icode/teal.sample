-- A typed record
local record Point
   x: number
   y: number
end

local function distance(a: Point, b: Point): number
   local dx = a.x - b.x
   local dy = a.y - b.y
   return math.sqrt(dx * dx + dy * dy)
end

local p: Point = { x = 1, y = 2.5 }
print("distance: " .. distance(p, { x = 4, y = 6 }))
