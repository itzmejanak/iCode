forward
global type w_main from window
end type
end forward

global type w_main from window
integer width = 1200
string title = "Orders"
end type

event open;
// Load the orders
long ll_rows
ll_rows = dw_orders.Retrieve()
if ll_rows > 0 then
	MessageBox("Orders", "Loaded " + String(ll_rows))
end if
end event
