root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{kt,kts}]
indent_style = space
indent_size = 4
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true

[*.md]
trim_trailing_whitespace = false

# A licence's text is kept byte for byte as its owner publishes it: what records its acceptance is
# the hash of exactly these bytes (docs/runtime-and-terminal.md).
[app/src/main/assets/runtime/licences/*.txt]
insert_final_newline = false
trim_trailing_whitespace = false
