+/* How long tracees get to act on a request to end before being
+ * killed.  */
+#define END_GRACE_MS 2000
+
+static bool end_pending = false;
+static struct timespec end_time;
+
+/**
+ * Send @signum to every tracee still running -- SIGHUP is what a
+ * closing terminal delivers -- and remember when, so the event loop
+ * can kill those that ignore it once the grace period is over.
+ * Killing them outright gave a server or a git command no chance to
+ * clean up.  A second request does not extend the first one's grace
+ * period.
+ */
+void end_all_tracees(int signum)
+{
+	Tracee *tracee;
+
+	LIST_FOREACH(tracee, &tracees, link)
+		if (!tracee->terminated)
+			kill(tracee->pid, signum);
+
+	if (end_pending)
+		return;
+
+	if (clock_gettime(CLOCK_MONOTONIC, &end_time) < 0) {
+		/* Without a clock there is no grace period to measure.  */
+		kill_all_tracees();
+		return;
+	}
+	end_pending = true;
+}
+
+/**
+ * Kill the tracees that outlived the grace period of a request to
+ * end.  This function returns true while that period is still
+ * running, so the event loop keeps waking up to check it.
+ */
+bool enforce_end_deadline()
+{
+	struct timespec now;
+	long long elapsed_ms;
+
+	if (!end_pending)
+		return false;
+
+	if (clock_gettime(CLOCK_MONOTONIC, &now) < 0)
+		elapsed_ms = END_GRACE_MS;
+	else
+		elapsed_ms = (now.tv_sec - end_time.tv_sec) * 1000LL
+			+ (now.tv_nsec - end_time.tv_nsec) / 1000000LL;
+
+	if (elapsed_ms < END_GRACE_MS)
+		return true;
+
+	end_pending = false;
+	kill_all_tracees();
+	return false;
+}
+
