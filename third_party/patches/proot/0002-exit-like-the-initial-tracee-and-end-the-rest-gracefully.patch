+/**
+ * Terminate this process with @signum, the way the program it ran was
+ * terminated.
+ */
+static void die_by_signal(int signum)
+{
+	sigset_t mask;
+
+	signal(signum, SIG_DFL);
+	sigemptyset(&mask);
+	sigaddset(&mask, signum);
+	sigprocmask(SIG_UNBLOCK, &mask, NULL);
+	raise(signum);
+
+	/* Only reached for a signal whose default action doesn't
+	 * terminate: report it the way shells do.  */
+	exit(128 + signum);
+}
+
